# Copy this file to .env.local and fill in the values you need.
# Defaults work out of the box for local development.

# --- Required ---
# Used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="dev-only-replace-me-in-production-please-do-not-ship-this"

# Path to the SQLite database file. The default is fine for development.
DATABASE_URL="data/dev.db"

# Restrict sign-in to a single Google Workspace domain.
ALLOWED_HD="govtech.gov.bb"

# Inbound email address printed in the UI as the forwarding target.
INBOUND_EMAIL_ADDRESS="crm@inbound.govtech.gov.bb"

# --- Optional: Google OAuth (production sign-in) ---
# Leave empty to keep the local sign-in screen, which lets you choose any
# seeded user without a real OAuth flow.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- Optional: Anthropic Claude (email summarisation) ---
# Leave empty for a deterministic stub extractor that uses the email body
# to fabricate a summary. Useful for demos.
# ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- Optional: shared secret for the inbound email webhook ---
# When set, the webhook requires header X-Inbound-Token to match.
# INBOUND_EMAIL_TOKEN=""
