{
  "name": "govtech-stakeholders",
  "version": "0.1.0",
  "private": true,
  "description": "GovTech Barbados Stakeholders CRM – pilot",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "mkdir -p data && drizzle-kit push",
    "db:seed": "mkdir -p data && tsx src/db/seed.ts",
    "db:reset": "rm -f data/dev.db && npm run db:push && npm run db:seed",
    "setup": "npm install && npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "better-sqlite3": "^11.5.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.4",
    "jose": "^5.9.6",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
